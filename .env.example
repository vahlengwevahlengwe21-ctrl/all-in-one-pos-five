# Server-only MySQL connection
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=your-mysql-database
DB_SSL=true
# Optional PEM-encoded CA certificate; encode line breaks as \n.
DB_SSL_CA=
# Optional expected MySQL TLS certificate hostname when DB_HOST is an IP.
DB_SSL_SERVERNAME=

# Optional remote POS database gateway. When set, the app server uses this
# HTTPS gateway instead of connecting to MySQL directly.
DB_GATEWAY_URL=
DB_GATEWAY_TOKEN=

# Set these securely once when bootstrapping the first or existing super administrator,
# then remove both after the script succeeds.
MYSQL_SUPER_ADMIN_EMAIL=jeff@gmail.com
MYSQL_SUPER_ADMIN_PASSWORD=
# Keep this 64-character random token in Vercel Production secrets only.
MYSQL_SUPER_ADMIN_SETUP_TOKEN=

# Google Gemini API key, used by product description generation
GEMINI_API_KEY=replace-with-your-key

# Used only when running Electron locally; packaged builds use electron/config.cjs
LIVE_APP_URL=https://all-in-one-pos-five.vercel.app

# Public application URL. PayFast requires HTTPS in production.
NEXT_PUBLIC_APP_URL=https://your-pos-domain.example

# PayFast subscription billing
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_BASE_URL=https://sandbox.payfast.co.za
POS_MONTHLY_FEE_ZAR=550.00
