{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 9002",
    "create:super-admin": "node scripts/create-super-admin.js",
    "migrate:shop-data": "node scripts/migrate-shop-data.js",
    "build": "next build",
    "start": "next start",
    "electron:dev": "electron electron/main.cjs",
    "electron:rebuild": "electron-rebuild -f -w sqlite3",
    "electron:make": "npm run electron:rebuild && electron-forge make",
    "electron:make:builder": "npm run electron:rebuild && electron-builder --win nsis",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "3.3.4",
    "@radix-ui/react-accordion": "1.1.2",
    "@radix-ui/react-alert-dialog": "1.0.5",
    "@radix-ui/react-avatar": "1.0.4",
    "@radix-ui/react-checkbox": "1.0.4",
    "@radix-ui/react-collapsible": "1.0.3",
    "@radix-ui/react-dialog": "1.0.5",
    "@radix-ui/react-dropdown-menu": "2.0.6",
    "@radix-ui/react-label": "2.0.2",
    "@radix-ui/react-menubar": "1.0.4",
    "@radix-ui/react-popover": "1.0.7",
    "@radix-ui/react-progress": "1.0.3",
    "@radix-ui/react-radio-group": "1.1.3",
    "@radix-ui/react-scroll-area": "1.0.5",
    "@radix-ui/react-select": "2.0.0",
    "@radix-ui/react-separator": "1.0.3",
    "@radix-ui/react-slider": "1.1.2",
    "@radix-ui/react-slot": "1.0.2",
    "@radix-ui/react-switch": "1.0.3",
    "@radix-ui/react-tabs": "1.0.4",
    "@radix-ui/react-toast": "1.1.5",
    "@radix-ui/react-tooltip": "1.0.7",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "dotenv": "16.4.5",
    "embla-carousel-react": "8.0.4",
    "lucide-react": "0.379.0",
    "mysql2": "^3.24.6",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-day-picker": "8.10.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.51.4",
    "react-to-print": "2.15.1",
    "recharts": "2.12.7",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "2.3.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "20.12.12",
    "@types/react": "18.3.2",
    "@types/react-dom": "18.3.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.3",
    "typescript": "5.4.5"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.2",
    "@types/react-dom": "18.3.0"
  },
  "main": "electron/main.cjs",
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "SpazaPOS",
        "executableName": "SpazaPOS",
        "ignore": [
          "[\\\\/]\\.next(?:[\\\\/]|$)",
          "[\\\\/]\\.git(?:[\\\\/]|$)",
          "[\\\\/]\\.vercel(?:[\\\\/]|$)",
          "[\\\\/]\\.idx(?:[\\\\/]|$)",
          "[\\\\/]\\.vs(?:[\\\\/]|$)",
          "[\\\\/]src(?:[\\\\/]|$)",
          "[\\\\/]public(?:[\\\\/]|$)",
          "[\\\\/]docs(?:[\\\\/]|$)",
          "[\\\\/]scripts(?:[\\\\/]|$)",
          "[\\\\/]\\.env(?:[^\\\\/]*)(?:$)",
          "[\\\\/]README\\.md$",
          "[\\\\/]apphosting\\.yaml$",
          "[\\\\/]next-env\\.d\\.ts$",
          "[\\\\/]tsconfig(?:[^\\\\/]*)$",
          "[\\\\/]tailwind\\.config\\.ts$",
          "[\\\\/]postcss\\.config\\.mjs$",
          "[\\\\/]components\\.json$",
          "[\\\\/]node_modules[\\/](?!(?:sqlite3|bindings|file-uri-to-path)(?:[\\/]|$))"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "SpazaPOS"
          }
        }
      ]
    }
  },
  "build": {
    "appId": "com.allinonepos.desktop",
    "productName": "All In One POS",
    "directories": {
      "output": "out-builder"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "win": {
      "target": "nsis",
      "executableName": "AllInOnePOS"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
